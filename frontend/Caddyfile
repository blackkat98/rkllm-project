{
	# never bind 80/443: the Pi's own Caddy (on the shared "proxy" network) is the front door
	auto_https off
	admin off
	servers {
		# keep the real client IP forwarded by the front proxy (used by the login throttle)
		trusted_proxies static private_ranges
	}
}

:{$WEB_PORT:8090} {
	encode zstd gzip

	@api path /api/* /v1/*
	handle @api {
		reverse_proxy {$BACKEND_HOST:backend}:{$BACKEND_PORT:8000} {
			# stream tokens immediately (Server-Sent Events)
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@immutable path /_nuxt/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html /200.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
