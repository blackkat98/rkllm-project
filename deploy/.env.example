# Copy to deploy/.env and edit. Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# first admin account (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

APP_NAME=RKLLM Chat

# Ports inside Docker. Port 80/443 are never used. WEB_PORT is also bound to 127.0.0.1 on the Pi
# (Cloudflare tunnel -> localhost:WEB_PORT); the shared Caddy reaches it as rkllm-web:${WEB_PORT}.
# If you change WEB_PORT, change it in deploy/Caddyfile.host / the Pi's Caddyfile too.
WEB_PORT=8090
BACKEND_PORT=8000

# true because Cloudflare serves the site over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=true

# where the .rkllm files live on the Pi (Gemma 3 1B + Llama 3.2 1B are already there)
MODELS_DIR=/home/nam/rkllm-models

# <=4B parameter policy (see README). 4B w8a8 files are ~3.6-5.3 GB and need ~5-6 GB RAM.
MAX_MODEL_FILE_GB=5.5
MAX_MODEL_RAM_MB=6000

# unload the model after N idle minutes to free RAM (0 = keep it loaded)
IDLE_UNLOAD_MINUTES=0
# reuse the NPU KV cache when continuing the same chat (tier-3 memory)
KV_FAST_PATH=true
