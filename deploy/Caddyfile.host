# Block for the shared Caddy on the Pi: /home/nam/prj/caddy/Caddyfile
# (above the catch-all ":80" block), then reload it:
#   cd ~/prj/caddy && docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Cloudflare Zero Trust → Networks → Tunnels → (this tunnel) → Public hostnames:
#   rkllm-chat.blackkat.bond  →  HTTP  →  localhost:8090   (WEB_PORT, bound to 127.0.0.1)
# The tunnel can also point at localhost:80 instead; this block then picks the app by hostname.
# Never put the app itself on 80/443.

http://rkllm-chat.blackkat.bond {
	reverse_proxy rkllm-web:8090 {
		# Cloudflare's view of the visitor's IP (the login throttle uses it)
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		# stream tokens to the browser immediately (Server-Sent Events)
		flush_interval -1
	}
}
